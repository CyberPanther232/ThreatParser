# Copy this file to .env and fill in the values.
# Never commit .env to source control.

# Flask secret key — set a long random string in production.
SECRET_KEY=change-me-to-a-long-random-string

# API key authentication
# Comma-separated list of valid API keys.
# Leave empty to disable authentication (dev/open mode).
# Example: THREATPARSER_API_KEYS=key1,key2,key3
THREATPARSER_API_KEYS=

# Rate limiting (requests per minute, per IP)
THREATPARSER_RATE_LIMIT_ANALYZE=20
THREATPARSER_RATE_LIMIT_HEALTH=60

# Set to "true" when ThreatParser runs behind a reverse proxy (nginx, etc.)
# so that X-Forwarded-For is trusted for rate-limit keying.
THREATPARSER_TRUSTED_PROXY=false

# Server bind settings
THREATPARSER_HOST=0.0.0.0
THREATPARSER_PORT=80
THREATPARSER_DEBUG=true

# TLS/SSL settings
# Set THREATPARSER_SSL_ENABLED=true to enable HTTPS.
# For production, provide both cert and key files.
# For local testing only, set THREATPARSER_SSL_ADHOC=true to use a temporary
# self-signed certificate generated by Werkzeug.
THREATPARSER_SSL_ENABLED=false
THREATPARSER_SSL_CERT_FILE=
THREATPARSER_SSL_KEY_FILE=
THREATPARSER_SSL_ADHOC=false
